<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "ITT588 Login Lab" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <main class="page-shell">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>" role="alert"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
