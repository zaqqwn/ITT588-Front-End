<% content_for :title, "Login | ITT588 Lab" %>

<section class="login-card" aria-labelledby="login-title">
  <div class="login-card__intro">
    <p class="eyebrow">ITT588 · Lab Work 01</p>
    <h1 id="login-title">Welcome back</h1>
    <p>Sign in with the username and password stored in <code>Password.txt</code>.</p>
  </div>

  <%= form_with url: login_path, method: :post, class: "login-form" do |form| %>
    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username,
            value: params[:username],
            autocomplete: "username",
            autofocus: true,
            required: true,
            placeholder: "Enter your username" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password,
            autocomplete: "current-password",
            required: true,
            placeholder: "Enter your password" %>
    </div>

    <%= form.submit "Log in", class: "button button--primary" %>
  <% end %>

  <p class="login-card__hint">Try <strong>admin</strong> / <strong>admin123</strong></p>
</section>
