<% content_for :title, "Get Help | SafeSpace Malaysia" %>

<section class="page-hero page-hero--peach">
  <div class="container page-hero__content">
    <span class="eyebrow">Verified support</span>
    <h1>Help is available.</h1>
    <p>Choose the option that best fits your situation. You can ask for information even if you are not ready to make a report.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="urgent-card">
      <div class="urgent-card__icon" aria-hidden="true">!</div>
      <div><span>Immediate danger</span><h2>Call emergency services</h2><p>If violence is happening now or someone is in immediate danger, move to a safer place if you can.</p></div>
      <a href="tel:999" class="button button--danger">Call 999</a>
    </div>

    <div class="section-heading">
      <span class="eyebrow">Malaysia support directory</span>
      <h2>Talk to someone you can trust</h2>
    </div>

    <div class="hotline-grid">
      <article class="hotline-card">
        <span class="status-pill">24 hours</span>
        <h3>Talian Kasih</h3>
        <p>Government helpline for abuse, counselling, protection, welfare and other social support.</p>
        <div class="contact-line"><small>Call</small><a href="tel:15999">15999</a></div>
        <div class="contact-line"><small>WhatsApp</small><a href="https://wa.me/60192615999">019-261 5999</a></div>
      </article>

      <article class="hotline-card">
        <span class="status-pill">Specialist support</span>
        <h3>Women's Aid Organisation</h3>
        <p>Free and confidential information, crisis support, shelter referrals and social work services.</p>
        <div class="contact-line"><small>Hotline</small><a href="tel:+60330008858">03-3000 8858</a></div>
        <div class="contact-line"><small>WhatsApp TINA</small><a href="https://wa.me/60189888058">018-988 8058</a></div>
      </article>

      <article class="hotline-card">
        <span class="status-pill">Medical care</span>
        <h3>One Stop Crisis Centre</h3>
        <p>Government hospital emergency departments can provide treatment, collect medical evidence and connect you with further support.</p>
        <div class="contact-line"><small>Where</small><strong>Nearest government hospital</strong></div>
      </article>
    </div>

    <div class="source-note">
      <strong>Contact information checked October 2026.</strong>
      <span>Sources: <a href="https://www.malaysia.gov.my/topics/talian-kasih-15999">Government Talian Kasih directory</a> and <a href="https://wao.org.my/what-to-expect-when-you-contact-wao/">WAO service information</a>.</span>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container content-grid">
    <div class="prose">
      <span class="eyebrow">Before contacting support</span>
      <h2>Protect your privacy where possible</h2>
      <ul class="check-list">
        <li>Use a device the person causing harm cannot access, if available.</li>
        <li>Turn off message previews and location sharing if it is safe to do so.</li>
        <li>Write important numbers on paper or save them under another name.</li>
        <li>Delete call or browser history only if doing so will not raise suspicion.</li>
      </ul>
    </div>
    <aside class="info-box info-box--warm">
      <strong>Supporting someone else?</strong>
      <p>Specialist services can also advise friends and family on how to respond safely and respectfully.</p>
      <%= link_to "Read responder guidance", enforcer_path, class: "text-link" %>
    </aside>
  </div>
</section>
